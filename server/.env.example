NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
DATABASE_URL=postgresql://user:pass@localhost:5432/circulink
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# 阿里云邮件推送（DirectMail）SMTP 配置，详见根目录 .env.example 的说明
DM_SMTP_HOST=smtpdm.aliyun.com
DM_SMTP_PORT=465
DM_SMTP_USER=no-reply@yourdomain.com
DM_SMTP_PASS=your-smtp-password
MAIL_FROM_NAME=Circulink
APP_BASE_URL=http://localhost:5173

# Cloudflare R2（图片存储），详见根目录 .env.example 的说明
# 留空时自动降级为本地磁盘 uploads/ 目录
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
