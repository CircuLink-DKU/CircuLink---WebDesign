# Backend API URL
VITE_API_URL=http://localhost:4000/api

# Test credentials for development
VITE_TEST_EMAIL=test@example.com
VITE_TEST_PASSWORD=password123
# Optional: set to true to auto-login test account in dev
VITE_ENABLE_DEV_AUTO_LOGIN=false

# Backend server configuration
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/circulink
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
PORT=4000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# LLM (OpenAI-compatible)
# OpenAI default:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# SiliconFlow example:
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=<your-siliconflow-model-id>

# 阿里云邮件推送（DirectMail）SMTP 配置
# 开通步骤：控制台 -> 邮件推送 -> 域名验证(DNS 加 SPF/DKIM/MX) -> 发信地址 -> 生成 SMTP 密码
# 国内区域 host 通常是 smtpdm.aliyun.com；新加坡等国际区域是 smtpdm.ap-southeast-1.aliyuncs.com
# 未配置时（本地开发常见）会自动降级为把邮件内容打印到日志，不会报错也不会真的发信
DM_SMTP_HOST=smtpdm.aliyun.com
DM_SMTP_PORT=465
DM_SMTP_USER=no-reply@yourdomain.com
DM_SMTP_PASS=your-smtp-password
MAIL_FROM_NAME=Circulink
# 验证/重置密码邮件里的链接会拼接到这个前缀（一般是前端地址）
APP_BASE_URL=http://localhost:5173
