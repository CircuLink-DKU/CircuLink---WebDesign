generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Seed configuration
// To run seeds: npm run prisma:seed

// Note: enums are validated in app layer for now
// Role: USER, ADMIN, CLUB_OPERATOR, BUY42_PARTNER
// Condition: NEW, LIKE_NEW, GOOD, FAIR
// ItemStatus: DRAFT, PENDING_REVIEW, ACTIVE, REJECTED, SOLD, ARCHIVED, HIDDEN
// DonationStatus: PENDING_REVIEW, ACTIVE, REJECTED, RESERVED, CLAIMED, ARCHIVED, HIDDEN
// ReviewStatus: APPROVED, PENDING_REVIEW, REJECTED
// ReviewQueueStatus: PENDING, APPROVED, REJECTED
// OrderStatus: PENDING, ACCEPTED, REJECTED, PAID, SHIPPED, COMPLETED, CANCELLED

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String?
  role          String          @default("USER")
  emailVerifiedAt DateTime?
  profile       Profile?
  items         Item[]
  donations     Donation[]
  submittedReviews ReviewQueue[] @relation("submittedReviews")
  assignedReviews  ReviewQueue[] @relation("assignedReviews")
  reviewedReviews  ReviewQueue[] @relation("reviewedReviews")
  reviewDecisions  ReviewDecision[] @relation("reviewDecisions")
  favorites     Favorite[]
  messages      Message[]
  threadsAsBuyer  MessageThread[] @relation("buyerThreads")
  threadsAsSeller MessageThread[] @relation("sellerThreads")
  ordersAsBuyer   Order[]         @relation("ordersAsBuyer")
  ordersAsSeller  Order[]         @relation("ordersAsSeller")
  refreshTokens RefreshToken[]
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  itemViews     ItemView[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Donation {
  id           String   @id @default(cuid())
  description  String
  status       String   @default("ACTIVE")
  reviewStatus String   @default("APPROVED")
  categoryId   String
  donorId      String
  images       String
  category     Category @relation(fields: [categoryId], references: [id])
  donor        User     @relation(fields: [donorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([donorId])
  @@index([status])
  @@index([reviewStatus])
  @@index([createdAt])
  @@index([categoryId, status, createdAt])
}

model ReviewQueue {
  id                 String           @id @default(cuid())
  targetType         String
  targetId           String
  submissionType     String
  submittedById      String
  status             String           @default("PENDING")
  riskLevel          String           @default("LOW")
  flags              String           @default("[]")
  summary            String?
  assignedReviewerId String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  submittedBy        User             @relation("submittedReviews", fields: [submittedById], references: [id])
  assignedReviewer   User?            @relation("assignedReviews", fields: [assignedReviewerId], references: [id])
  reviewedBy         User?            @relation("reviewedReviews", fields: [reviewedById], references: [id])
  decisions          ReviewDecision[]

  @@index([targetType, targetId])
  @@index([submissionType])
  @@index([submittedById])
  @@index([status])
  @@index([riskLevel])
  @@index([assignedReviewerId])
  @@index([reviewedById])
  @@index([createdAt])
}

model ReviewDecision {
  id         String      @id @default(cuid())
  reviewId   String
  reviewerId String
  decision   String
  reasonCode String?
  comment    String?
  createdAt  DateTime    @default(now())
  review     ReviewQueue @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewer   User        @relation("reviewDecisions", fields: [reviewerId], references: [id])

  @@index([reviewId])
  @@index([reviewerId])
  @@index([decision])
  @@index([createdAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  displayName String
  avatarUrl String?
  university String?
  phone     String?
  bio       String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  items     Item[]
  donations Donation[]
  createdAt DateTime @default(now())
}

model Item {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Float
  condition   String
  status      String      @default("ACTIVE")
  categoryId  String
  sellerId    String
  images      String
  category    Category    @relation(fields: [categoryId], references: [id])
  seller      User        @relation(fields: [sellerId], references: [id])
  favorites   Favorite[]
  threads     MessageThread[]
  orders      Order[]
  views       ItemView[]
  stats       ItemStats?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@index([condition])
  @@index([price])
  @@index([createdAt])
  @@index([categoryId, status, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  user      User     @relation(fields: [userId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

model MessageThread {
  id        String   @id @default(cuid())
  itemId    String
  buyerId   String
  sellerId  String
  item      Item     @relation(fields: [itemId], references: [id])
  buyer     User     @relation("buyerThreads", fields: [buyerId], references: [id])
  seller    User     @relation("sellerThreads", fields: [sellerId], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())

  @@unique([itemId, buyerId, sellerId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  isRead    Boolean  @default(false)
  thread    MessageThread @relation(fields: [threadId], references: [id])
  sender    User          @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderId])
}

model Order {
  id        String      @id @default(cuid())
  itemId    String
  buyerId   String
  sellerId  String
  status    String      @default("PENDING")
  total     Float
  item      Item        @relation(fields: [itemId], references: [id])
  buyer     User        @relation("ordersAsBuyer", fields: [buyerId], references: [id])
  seller    User        @relation("ordersAsSeller", fields: [sellerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ItemView {
  id        String   @id @default(cuid())
  itemId    String
  viewerId  String?
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([viewerId])
  @@index([createdAt])
}

model ItemStats {
  id          String   @id @default(cuid())
  itemId      String   @unique
  viewCount   Int      @default(0)
  lastViewedAt DateTime?
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
