# Frontend production API endpoints.
# If API is served under the same domain through nginx /api proxy, use:
VITE_API_URL=https://circulink.cn/api
VITE_API_BASE_URL=https://circulink.cn

# Disable local development helpers in production builds.
VITE_ENABLE_DEV_AUTO_LOGIN=false

# Backend production settings.
# NOTE: this file is loaded by systemd via EnvironmentFile (see deploy/circulink.service).
# systemd's parser is NOT a shell and NOT dotenv: keep every line `KEY=value` with
# NO surrounding quotes and NO inline `# comments` after a value, or the quotes/#
# become part of the value (breaking JWT/SMTP secrets that contain special chars).
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/circulink
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-production-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=https://circulink.cn,https://www.circulink.cn
UPLOAD_DIR=uploads

# Restrict registration to community email domains (comma-separated). Leave empty
# for open registration. For a DKU-only launch, set your campus domain(s), e.g.:
#   ALLOWED_EMAIL_DOMAINS=dukekunshan.edu.cn,duke.edu
ALLOWED_EMAIL_DOMAINS=

# Email (Aliyun DirectMail SMTP). REQUIRED in production, otherwise verification
# and password-reset emails are silently dropped (only logged). APP_BASE_URL must
# be the public site URL — reset/verify links are built from it (defaults to
# http://localhost:5173, which would make production email links point to localhost).
DM_SMTP_HOST=smtpdm.aliyun.com
DM_SMTP_PORT=465
DM_SMTP_USER=no-reply@circulink.cn
DM_SMTP_PASS=replace-with-directmail-smtp-password
MAIL_FROM_NAME=Circulink
APP_BASE_URL=https://circulink.cn

# LLM for the AI listing assistant (OpenAI-compatible). On a mainland-China host
# api.openai.com is usually unreachable — point these at a domestic endpoint
# (e.g. SiliconFlow). Leave OPENAI_API_KEY empty to disable AI (it falls back to
# a heuristic instead of erroring).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Cloudflare R2 object storage for uploads (optional). When ALL five are set the
# API stores images in R2 instead of local disk; otherwise it falls back to
# UPLOAD_DIR on local disk.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
